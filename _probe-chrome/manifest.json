{
  "manifest_version": 3,
  "name": "ikkyoku - 中継盤面診断 (Phase 0)",
  "version": "0.1.0",
  "description": "ABEMA将棋中継から盤面情報を取得できるか診断する Chrome 拡張（Phase 0 検証用プロトタイプ）",
  "permissions": ["sidePanel", "tabs", "activeTab"],
  "host_permissions": ["https://abema.tv/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ikkyoku — 盤面診断"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://abema.tv/*"],
      "js": ["content/main-world-hook.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["https://abema.tv/*"],
      "js": ["content/bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "commands": {
    "capture-snapshot": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "盤面のスナップショット診断を実行する"
    }
  }
}
