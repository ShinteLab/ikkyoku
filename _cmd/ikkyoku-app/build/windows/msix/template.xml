<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="ikkyoku-app.exe"
        Arguments=""
        InstallLocation="C:\Program Files\ShinteLab\ikkyoku">
    </Installer>
    <PackageInformation
        PackageName="ikkyoku"
        PackageDisplayName="ikkyoku"
        PublisherName="CN=ShinteLab"
        PublisherDisplayName="ShinteLab"
        Version="0.1.0.0"
        PackageDescription="ikkyoku - shogi broadcast capture">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.shintelab.ikkyoku"
                Description="ikkyoku - shogi broadcast capture"
                DisplayName="ikkyoku"
                ExecutableName="ikkyoku-app.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>ikkyoku</DisplayName>
            <PublisherDisplayName>ShinteLab</PublisherDisplayName>
            <Description>ikkyoku - shogi broadcast capture</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="ikkyoku-app.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
